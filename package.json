{
  "name": "@xiao-53/dsh-mindmap",
  "version": "0.4.4",
  "description": "DSH 原生侧栏思维导图，支持 Markdown 笔记、布局保存和离线 HTML 导出。",
  "license": "MIT",
  "keywords": [
    "dsh-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xiao-53/dsh-mindmap.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/typert.js",
    "cordis.yml"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-alpha.3 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "test": "node --experimental-strip-types --test tests/shared/*.test.ts tests/integration/*.test.ts",
    "prepack": "npm run build",
    "pack:plugin": "node scripts/pack-release.mjs",
    "pretest": "npm run build && node scripts/build-ui-tests.mjs",
    "verify:layer1": "node scripts/e2e-env.mjs layer1",
    "verify:e2e:start": "node scripts/e2e-env.mjs start",
    "verify:e2e:serve": "node scripts/e2e-env.mjs serve",
    "verify:e2e:stop": "node scripts/e2e-env.mjs stop"
  },
  "dependencies": {
    "katex": "0.19.1",
    "marked": "17.0.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-client-store": ">=0.2.2-alpha.3 <0.3.0-0",
    "@deepseek-ai/dsh-skill": ">=0.2.2-alpha.3 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-alpha.3 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-alpha.3 <0.3.0-0",
    "react": "^18.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-workspace-files": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-resources": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.3",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.3",
    "@deepseek-ai/dsh-fs-local": "0.2.2-rc.3",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-loader": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.3",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.2-rc.3",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.27.0",
    "jsdom": "^27.4.0",
    "jsxgraph": "1.14.3",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.3",
    "zod": "4.6.6"
  }
}
